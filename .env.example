# Copy to .env.local and fill in. .env* is gitignored — never commit real secrets.

# --- Database ---
# Local development (matches docker-compose.yml):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fintech_dev"
#
# Production (Neon): use the POOLED connection string, the one with "-pooler" in
# the host. Serverless functions open a connection per invocation, and the
# direct string runs out of connections under any real traffic.
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require"

# --- Auth (Better Auth) ---
# Generate your own — never reuse this placeholder outside local dev:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-32-plus-random-characters-abcd"

# Must match the origin the app is actually served from, or the session cookie
# lands on the wrong domain and login silently fails.
#   local:      http://localhost:3000
#   production: https://your-app.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# --- Demo account ---
# Seeded read-only account so a recruiter can click around without signing up.
DEMO_EMAIL="demo@example.com"

# --- Optional ---
# Enables LLM-backed features. Leave unset and they render disabled with a
# tooltip — the app still runs fully without it, which is the point.
# ANTHROPIC_API_KEY="sk-ant-..."
